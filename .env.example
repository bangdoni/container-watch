# ContainerWatch configuration reference.
#
# Every variable is optional: with an empty environment the server listens on
# :8080, stores its SQLite database in ./data and auto-discovers a local
# Docker or Podman socket. Copy to `.env` and adjust as needed — the binary
# itself reads the process environment only, so export these or pass them with
# `docker run --env-file .env ...`.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Listen address. Use ":8080" to bind all interfaces, "127.0.0.1:8080" to keep
# the UI local (pair with a reverse proxy).
CW_ADDR=:8080

# Externally reachable base URL, e.g. https://containers.example.com.
# Leave empty to derive it from each request (works behind most proxies).
CW_PUBLIC_URL=

# Set to true when serving over HTTPS so cookies get the Secure attribute.
# Leave empty to infer from the request (TLS or X-Forwarded-Proto).
CW_SECURE_COOKIES=

# Trust X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host from a reverse
# proxy in front of ContainerWatch. Only enable this when a trusted proxy
# terminates the connection.
CW_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Storage & secrets
# ---------------------------------------------------------------------------

# Directory for the SQLite database and the generated session secret.
CW_DATA_DIR=./data

# Explicit database path. Defaults to $CW_DATA_DIR/containerwatch.db.
CW_DATABASE_PATH=

# Secret used to derive cookie namespaces. When empty a random 64-character
# secret is generated once and persisted in $CW_DATA_DIR/secret.key. Set this
# explicitly when running multiple replicas against the same database.
CW_COOKIE_SECRET=

# Absolute login session lifetime.
CW_SESSION_TTL=24h

# ---------------------------------------------------------------------------
# Container engines
# ---------------------------------------------------------------------------

# Comma-separated list of local sockets to probe, formatted as
# engine:///path where the scheme is a hint (docker or podman).
# The engine type is detected on connect, so a plain docker:// entry for a
# Podman socket works fine.
# Set to "none" to disable local discovery entirely (remote nodes only).
CW_LOCAL_SOCKETS=docker:///var/run/docker.sock,podman:///run/podman/podman.sock

# ---------------------------------------------------------------------------
# Metrics & logging
# ---------------------------------------------------------------------------

# How often containers are sampled for the live metrics SSE stream.
# Minimum 250ms. 2s keeps the dashboard responsive without hammering the API.
CW_METRICS_INTERVAL=2s

# Samples retained per container (sparklines + charts). 5–3600.
# At 2s and 60 samples the window covers two minutes of history.
CW_METRICS_WINDOW=60

# debug | info | warn | error
CW_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------

# Initial value for the "open registration" setting. It only applies before an
# administrator saves the setting in the UI; the stored setting always wins.
CW_OPEN_REGISTRATION=false

# ---------------------------------------------------------------------------
# Container healthcheck
# ---------------------------------------------------------------------------

# URL used by `containerwatch -healthcheck` (the Docker HEALTHCHECK command).
# Defaults to http://127.0.0.1:<port>/healthz derived from CW_ADDR.
CW_HEALTHCHECK_URL=
